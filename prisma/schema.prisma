// schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator dbml {
  provider = "prisma-dbml-generator"
}

// ============================================
// COMMON ENUMS
// ============================================

enum UserRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
  VIEWER
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
  CUSTOM
}

enum PlanType {
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum Period {
  HOURLY
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum InsightType {
  COST_OPTIMIZATION
  PERFORMANCE
  USAGE_PATTERN
  SECURITY
  RELIABILITY
}

enum Priority {
  NORMAL
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum LoyaltyTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
  DIAMOND
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
  RESCHEDULED
}

enum BookingSource {
  WEBSITE
  PHONE
  WALK_IN
  REFERRAL
  SOCIAL
  MOBILE_APP
  EMAIL
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  REFUNDED
  FAILED
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  DEBIT_CARD
  BANK_TRANSFER
  PAYPAL
  STRIPE
  OTHER
}

// ============================================
// AUTHENTICATION MODELS 
// ============================================

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime? // Soft delete
  
  // Authentication relations
  sessions      Session[]
  accounts      Account[]
  
  // Analytics dashboard relations
  role          UserRole            @default(VIEWER)
  organizations OrganizationMember[]
  apiKeys       ApiKey[]
  auditLogs     AuditLog[]
  searchHistory SearchHistory[]
  insights      Insight[]
  notifications Notification[]
  
  // Booking CRM relations
  createdBookings Booking[] @relation("BookingCreatedBy")
  assignedBookings Booking[] @relation("BookingAssignedTo")
  customerNotes  CustomerNote[]
  bookingNotes   BookingNote[]

  @@index([email])
  @@index([isActive])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?  @db.Text
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([token])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, value])
  @@index([expiresAt])
  @@index([identifier])
  @@map("verifications")
}

// ============================================
// ANALYTICS DASHBOARD MODELS
// ============================================

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  plan        PlanType @default(STARTER)
  isActive    Boolean  @default(true)
  
  // Billing information
  billingEmail String?
  maxProjects  Int      @default(3)
  maxMembers   Int      @default(5)
  maxApiKeys   Int      @default(10)
  
  // Contact info
  website      String?
  phone        String?
  address      String?  @db.Text
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime? // Soft delete
  
  // Relations
  members     OrganizationMember[]
  projects    Project[]
  apiKeys     ApiKey[]
  roles       CustomRole[]
  webhooks    Webhook[]
  
  @@index([slug])
  @@index([isActive, plan])
  @@index([deletedAt])
  @@map("organizations")
}

model CustomRole {
  id             String   @id @default(cuid())
  name           String
  description    String?  @db.Text
  permissions    Json     @default("{}")
  isActive       Boolean  @default(true)
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  // Relations
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        OrganizationMember[]
  
  @@unique([organizationId, name])
  @@index([organizationId, isActive])
  @@map("custom_roles")
}

model OrganizationMember {
  id             String   @id @default(cuid())
  role           OrganizationRole @default(MEMBER)
  joinedAt       DateTime @default(now())
  isActive       Boolean  @default(true)
  
  // Custom role support
  customRoleId   String?
  customRole     CustomRole? @relation(fields: [customRoleId], references: [id], onDelete: SetNull)
  
  // Invitation tracking
  invitedBy      String?
  invitedAt      DateTime?
  
  // Relations
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  @@unique([userId, organizationId])
  @@index([organizationId, isActive])
  @@index([customRoleId])
  @@index([userId])
  @@map("organization_members")
}

model Project {
  id             String   @id @default(cuid())
  name           String
  description    String?  @db.Text
  isActive       Boolean  @default(true)
  
  // Project settings
  timezone       String   @default("UTC")
  alertsEnabled  Boolean  @default(true)
  
  // Environment
  environment    String   @default("production") // production, staging, development
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime? // Soft delete
  
  // Relations
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  usageMetrics   UsageMetric[]
  costRecords    CostRecord[]
  apiKeys        ApiKey[]
  clientActivity ClientActivity[]
  platformPerformance PlatformPerformance[]
  insights       Insight[]
  auditLogs      AuditLog[]
  alerts         Alert[]

  @@index([organizationId, isActive])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([environment])
  @@map("projects")
}

model ApiKey {
  id             String   @id @default(cuid())
  name           String
  key            String   @unique
  prefix         String
  permissions    Json     @default("[]")
  rateLimit      Int      @default(1000)
  isActive       Boolean  @default(true)
  lastUsed       DateTime?
  expiresAt      DateTime?
  createdAt      DateTime @default(now())
  
  // IP whitelist
  allowedIps     String[] @default([])
  
  // Relations
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String?
  project        Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  usageMetrics   UsageMetric[]
  
  @@index([organizationId, isActive])
  @@index([userId])
  @@index([expiresAt])
  @@index([key])
  @@map("api_keys")
}

model AiModel {
  id          String   @id @default(cuid())
  name        String   @unique
  provider    String
  modelFamily String
  contextSize Int
  isActive    Boolean  @default(true)
  
  // Pricing
  costPer1kInputTokens  Decimal @db.Decimal(10, 6)
  costPer1kOutputTokens Decimal @db.Decimal(10, 6)
  
  // Features
  capabilities Json    @default("{}")
  maxTokens    Int?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  usageMetrics UsageMetric[]
  costRecords  CostRecord[]
  
  @@index([provider, isActive])
  @@index([modelFamily])
  @@index([name])
  @@map("ai_models")
}

model UsageMetric {
  id          String   @id @default(cuid())
  timestamp   DateTime @default(now())
  period      Period   @default(HOURLY)
  
  // Token metrics
  tokenCount  Int
  promptTokens Int
  completionTokens Int
  
  // Request metrics
  requestCount Int
  userCount   Int
  cost        Decimal  @db.Decimal(10, 4)
  
  // Performance metrics
  avgLatency  Int?     // milliseconds
  p95Latency  Int?     // milliseconds
  p99Latency  Int?     // milliseconds
  errorCount  Int      @default(0)
  successRate Decimal? @db.Decimal(5, 2) // percentage
  
  // Metadata
  endpoint    String?
  statusCode  Int?
  userId      String?
  region      String?
  
  // Relations
  projectId   String
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  modelId     String
  model       AiModel @relation(fields: [modelId], references: [id], onDelete: Cascade)
  apiKeyId    String?
  apiKey      ApiKey? @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  
  // Indexes
  @@index([timestamp])
  @@index([projectId, timestamp])
  @@index([modelId, timestamp])
  @@index([apiKeyId, timestamp])
  @@index([period, timestamp])
  @@index([userId])
  @@map("usage_metrics")
}

model CostRecord {
  id          String   @id @default(cuid())
  period      DateTime
  periodType  Period   @default(MONTHLY)
  
  // Cost breakdown
  developmentCost Decimal @db.Decimal(10, 2)
  inferenceCost   Decimal @db.Decimal(10, 2)
  maintenanceCost Decimal @db.Decimal(10, 2)
  totalCost       Decimal @db.Decimal(10, 2)
  
  // Budget tracking
  budgetLimit     Decimal? @db.Decimal(10, 2)
  budgetUsed      Decimal  @default(0) @db.Decimal(5, 2) // percentage
  
  // Forecasting
  forecastedCost  Decimal? @db.Decimal(10, 2)
  
  // Metadata
  notes       String?  @db.Text
  currency    String   @default("USD")
  
  // Relations
  projectId   String
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  modelId     String
  model       AiModel @relation(fields: [modelId], references: [id], onDelete: Cascade)
  
  @@unique([projectId, modelId, period, periodType])
  @@index([period, periodType])
  @@index([totalCost])
  @@index([projectId, periodType])
  @@map("cost_records")
}

model PlatformPerformance {
  id           String   @id @default(cuid())
  timestamp    DateTime @default(now())
  platform     String
  uptime       Decimal  @db.Decimal(5, 2) // percentage
  reliability  Decimal  @db.Decimal(5, 2) // percentage
  avgResponseTime Decimal @db.Decimal(10, 2) // milliseconds
  errorRate    Decimal  @db.Decimal(5, 2) // percentage
  rateLimitRemaining Int?
  
  // Additional metrics
  requestsPerSecond Decimal? @db.Decimal(10, 2)
  concurrentRequests Int?
  
  // Relations
  projectId    String?
  project      Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  @@index([timestamp, platform])
  @@index([projectId, timestamp])
  @@index([platform])
  @@map("platform_performance")
}

model ClientActivity {
  id          String   @id @default(cuid())
  date        DateTime @default(now())
  period      Period   @default(DAILY)
  requests    Int
  tokens      Int
  activeUsers Int
  newUsers    Int
  
  // Additional metrics
  returningUsers Int   @default(0)
  avgSessionDuration Int? // seconds
  bounceRate     Decimal? @db.Decimal(5, 2) // percentage
  
  // Relations
  projectId   String
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  @@unique([projectId, date, period])
  @@index([date, period])
  @@index([projectId, date])
  @@map("client_activity")
}

model Insight {
  id          String     @id @default(cuid())
  title       String
  description String     @db.Text
  type        InsightType
  priority    Priority   @default(MEDIUM)
  isActive    Boolean    @default(true)
  isRead      Boolean    @default(false)
  
  // Actionable data
  impact      String?    // high, medium, low
  savingsPotential Decimal? @db.Decimal(10, 2)
  
  createdAt   DateTime   @default(now())
  expiresAt   DateTime?
  conditions  Json       @default("{}")
  actions     Json       @default("[]")
  
  // Relations
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([projectId, isActive, isRead])
  @@index([priority, createdAt])
  @@index([type, isActive])
  @@map("insights")
}

model Alert {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  condition   Json     // Alert conditions
  threshold   Decimal? @db.Decimal(10, 2)
  isActive    Boolean  @default(true)
  
  // Notification settings
  notifyEmail Boolean  @default(true)
  notifySlack Boolean  @default(false)
  notifyWebhook Boolean @default(false)
  
  lastTriggered DateTime?
  triggerCount  Int      @default(0)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  projectId   String
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  @@index([projectId, isActive])
  @@index([lastTriggered])
  @@map("alerts")
}

model Webhook {
  id          String   @id @default(cuid())
  url         String
  events      String[] // Array of event types
  secret      String?
  isActive    Boolean  @default(true)
  
  lastTriggered DateTime?
  successCount  Int      @default(0)
  failureCount  Int      @default(0)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  @@index([organizationId, isActive])
  @@map("webhooks")
}

model Notification {
  id          String   @id @default(cuid())
  title       String
  message     String   @db.Text
  type        String   // info, warning, error, success
  isRead      Boolean  @default(false)
  link        String?
  
  createdAt   DateTime @default(now())
  readAt      DateTime?
  
  // Relations
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

model SearchHistory {
  id          String   @id @default(cuid())
  query       String
  filters     Json?
  resultCount Int
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  
  @@index([userId, createdAt])
  @@index([query])
  @@map("search_history")
}

model AuditLog {
  id          String   @id @default(cuid())
  action      String
  resource    String
  resourceId  String?
  details     Json?
  ipAddress   String?
  userAgent   String?  @db.Text
  timestamp   DateTime @default(now())
  
  // Additional context
  status      String?  // success, failure
  errorMessage String? @db.Text
  
  // Relations
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([timestamp])
  @@index([userId, timestamp])
  @@index([projectId, timestamp])
  @@index([action, resource, timestamp])
  @@index([status])
  @@map("audit_logs")
}

// ============================================
// BOOKING CRM MODELS
// ============================================

model Customer {
  id           String   @id @default(cuid())
  fullName     String
  email        String   @unique
  phone        String
  company      String?
  address      String?  @db.Text
  notes        String?  @db.Text
  avatar       String?
  
  // Loyalty program
  loyaltyTier  LoyaltyTier?
  loyaltyPoints Int     @default(0)
  
  // Stats
  totalBookings Int     @default(0)
  totalSpent   Decimal  @default(0) @db.Decimal(10, 2)
  lastVisit    DateTime?
  preferences  String[]
  
  // Contact preferences
  emailOptIn   Boolean  @default(true)
  smsOptIn     Boolean  @default(false)
  marketingOptIn Boolean @default(false)
  
  // Status
  isActive     Boolean  @default(true)
  isVip        Boolean  @default(false)
  
  // Metadata
  source       String?
  referredBy   String?
  tags         String[]
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime? // Soft delete
  
  // Relations
  bookings     Booking[]
  customerNotes        CustomerNote[]
  
  @@index([email])
  @@index([phone])
  @@index([fullName])
  @@index([loyaltyTier, totalSpent])
  @@index([isActive, lastVisit])
  @@index([deletedAt])
  @@index([isVip])
  @@map("customers")
}

model Booking {
  id              String        @id @default(cuid())
  
  // Scheduling
  date            DateTime
  startTime       String
  endTime         String
  duration        Int           // minutes
  people          Int
  
  // Service details
  serviceType     String
  serviceName     String?
  occasion        String?
  specialRequests String?       @db.Text
  location        String?
  
  // Status and priority
  status          BookingStatus @default(PENDING)
  priority        Priority      @default(NORMAL)
  
  // Financial
  price           Decimal?      @db.Decimal(10, 2)
  deposit         Decimal?      @db.Decimal(10, 2)
  paymentStatus   PaymentStatus @default(UNPAID)
  paymentMethod   PaymentMethod?
  currency        String        @default("USD")
  
  // Discount
  discountAmount  Decimal?      @db.Decimal(10, 2)
  discountCode    String?
  
  // Feedback
  rating          Int?          // 1-5 stars
  feedback        String?       @db.Text
  
  // Metadata
  notes           String?       @db.Text
  notesCount      Int           @default(0)
  source          BookingSource @default(WEBSITE)
  tags            String[]
  
  // Reminders
  reminderSent    Boolean       @default(false)
  reminderSentAt  DateTime?
  confirmationSent Boolean      @default(false)
  
  // Timestamps
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  cancelledAt     DateTime?
  completedAt     DateTime?
  deletedAt       DateTime?     // Soft delete
  
  // Relations
  customerId      String
  customer        Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  staffAssignedId String?
  staffAssigned   User?         @relation("BookingAssignedTo", fields: [staffAssignedId], references: [id], onDelete: SetNull)
  createdById     String
  createdBy       User          @relation("BookingCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  bookingNotes    BookingNote[]
  
  @@index([date, status])
  @@index([customerId, date])
  @@index([staffAssignedId, date])
  @@index([status, createdAt])
  @@index([serviceType, date])
  @@index([source])
  @@index([paymentStatus])
  @@index([deletedAt])
  @@map("bookings")
}

model CustomerNote {
  id          String   @id @default(cuid())
  content     String   @db.Text
  isInternal  Boolean  @default(false)
  priority    Priority @default(NORMAL)
  tags        String[]
  
  // Attachments
  attachments String[] @default([])
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  
  @@index([customerId, createdAt])
  @@index([createdById])
  @@index([priority])
  @@map("customer_notes")
}

model BookingNote {
  id          String   @id @default(cuid())
  content     String   @db.Text
  isInternal  Boolean  @default(true)
  priority    Priority @default(NORMAL)
  tags        String[]
  
  // Attachments
  attachments String[] @default([])
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  bookingId   String
  booking     Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User    @relation(fields: [createdById], references: [id], onDelete: Cascade)
  
  @@index([bookingId, createdAt])
  @@index([createdById])
  @@index([priority])
  @@map("booking_notes")
}